# --- Database (Railway PostgreSQL) -----------------------------------------
# Railway → your Postgres service → Connect → copy the "Postgres Connection URL"
DATABASE_URL="postgresql://user:password@host.railway.app:5432/railway"

# --- NextAuth.js -------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Local dev; set to the deployed Netlify URL in production
NEXTAUTH_URL="http://localhost:3000"

# --- Resend (transactional email: OTP, notifications) ------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="GTECH Angels <noreply@gtechangels.org>"

# --- Cloudinary (pitch deck PDF uploads, max 20MB) ---------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
