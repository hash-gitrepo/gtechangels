# --- Database (Railway PostgreSQL) -----------------------------------------
# Railway → your Postgres service → Connect → copy the "Postgres Connection URL"
DATABASE_URL="postgresql://user:password@host.railway.app:5432/railway"

# --- NextAuth.js -------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Local dev; set to the deployed Netlify URL in production
NEXTAUTH_URL="http://localhost:3000"

# --- Resend (transactional email: OTP, notifications) ------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="GTECH Angels <noreply@gtechangels.org>"

# --- Pitch deck storage (FR-18, max 20MB) -------------------------------------
# Netlify Blobs — no env vars needed. It auto-configures from the deploy
# context on Netlify, and works locally only under `netlify dev` (not plain
# `next dev`); see README.md.
